{
  "description": "Guardrails for work on PlatformNEX services: blocks commands that deploy, change clusters or access, read secrets, or rewrite history; blocks edits to secrets, guardrail files and files outside the repository; formats Python files after an edit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-bash.sh\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-files.sh\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/post-edit.sh\"", "timeout": 20 }
        ]
      }
    ]
  }
}
