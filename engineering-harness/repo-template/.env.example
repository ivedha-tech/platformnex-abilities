# Local development only (make dev). Copy to .env. Never put real secrets or real data here.
# In every PlatformNEX environment, settings live in the component's GitOps overlay and
# secrets in Secret Manager; both are edited in a release's Configuration phase.
# To run against a real non-production environment, use `make dev-remote`: pnx supplies
# that environment's settings and secrets for the session.
APP_ENV=local
LOG_LEVEL=INFO
