# Copy to harness.config.env (git-ignored) and fill in. No secrets go in here.

# --- GitHub ---
GITHUB_ORG="your-github-org"
HANDBOOK_REPO="engineering-handbook"      # docs/, policies/, compliance/, templates/
INFRA_REPO="platform-infra"               # infra/
TEMPLATE_REPO="service-template"          # repo-template/
DEFAULT_BRANCH="main"
REQUIRED_APPROVALS=1                      # use 2 for repos that touch production data

# --- PlatformNEX ---
PNX_PORTAL_URL="https://agentic-platformnex-portal.prod.ivedha.dev"   # where services are onboarded and released
PNX_DEV_ENV="dit1"                        # the non-production environment developers run against
# Status checks every service repo must pass, comma separated, exactly as GitHub shows them.
# "PlatformNEX tests" only once TestOps is bound for the component.
REQUIRED_CHECKS="PlatformNEX review"

# --- GCP ---
GCP_ORG_ID="000000000000"
GCP_BILLING_ACCOUNT="AAAAAA-BBBBBB-CCCCCC"
PREFIX="acme"                             # short, lowercase; used in project ids
PRODUCT="core"                            # one harness instance per product / residency boundary
REGION="northamerica-northeast2"          # Toronto. UK: europe-west2. Montreal: northamerica-northeast1
WORKSPACE_DOMAIN="example.com"            # identities allowed in IAM
WORKSPACE_CUSTOMER_ID="C0xxxxxxx"         # gcloud organizations list --format='value(owner.directoryCustomerId)'

# --- People (Google groups, created in Workspace / Cloud Identity first) ---
GROUP_PLATFORM_ADMINS="gcp-platform-admins@example.com"
GROUP_DEVELOPERS="gcp-developers@example.com"
GROUP_SECURITY="gcp-security@example.com"
